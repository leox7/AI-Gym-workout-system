<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.aigym.app.controllers.WorkoutsController"
            prefHeight="768.0" prefWidth="1024.0"
            stylesheets="@../css/style.css">
    
    <!-- Left Sidebar -->
    <left>
        <VBox styleClass="sidebar" prefWidth="200.0" spacing="10.0">
            <Label text="AI Gym Workout" styleClass="title-label" />
            
            <Button fx:id="dashboardButton" text="Dashboard" styleClass="sidebar-button" onAction="#handleDashboardButtonAction" />
            <Button fx:id="workoutsButton" text="Workouts" styleClass="sidebar-button, active" onAction="#handleWorkoutsButtonAction" />
            <Button fx:id="progressButton" text="Progress" styleClass="sidebar-button" onAction="#handleProgressButtonAction" />
            <Button fx:id="profileButton" text="Profile" styleClass="sidebar-button" onAction="#handleProfileButtonAction" />
            
            <Region VBox.vgrow="ALWAYS" />
            
            <Button fx:id="logoutButton" text="Logout" styleClass="sidebar-button" onAction="#handleLogoutButtonAction" />
            
            <padding>
                <Insets top="20.0" right="10.0" bottom="20.0" left="10.0" />
            </padding>
        </VBox>
    </left>
    
    <!-- Main Content -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20.0" styleClass="content-area">
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="My Workouts" styleClass="title-label" />
                    <Region HBox.hgrow="ALWAYS" />
                    <ComboBox fx:id="filterComboBox" promptText="Filter Workouts" />
                    <Button fx:id="createWorkoutButton" text="Create Custom Workout" 
                            styleClass="primary-button" onAction="#handleCreateWorkoutButtonAction" />
                    <Button fx:id="getAiRecommendationsButton" text="Get AI Recommendations" 
                            styleClass="secondary-button" onAction="#handleGetAiRecommendationsButtonAction" />
                </HBox>
                
                <!-- Workouts Container -->
                <FlowPane fx:id="workoutsContainer" hgap="10.0" vgap="10.0" />
                
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
                </padding>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

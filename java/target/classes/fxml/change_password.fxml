<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.aigym.app.controllers.ChangePasswordController"
      prefHeight="250.0" prefWidth="400.0"
      spacing="15.0"
      stylesheets="@../css/style.css">
    
    <Label text="Change Password" styleClass="title-label" />
    
    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="150.0" prefWidth="150.0" />
            <ColumnConstraints prefWidth="200.0" />
        </columnConstraints>
        
        <Label text="Current Password:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <PasswordField fx:id="currentPasswordField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        
        <Label text="New Password:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <PasswordField fx:id="newPasswordField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        
        <Label text="Confirm New Password:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <PasswordField fx:id="confirmPasswordField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    </GridPane>
    
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancelButtonAction" />
        <Button fx:id="saveButton" text="Save" styleClass="primary-button" onAction="#handleSaveButtonAction" />
    </HBox>
    
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>
</VBox>

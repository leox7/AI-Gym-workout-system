<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.aigym.app.controllers.WorkoutDetailsController"
            prefHeight="600.0" prefWidth="800.0"
            stylesheets="@../css/style.css"
            styleClass="root">
            
    <top>
        <VBox spacing="10.0" styleClass="details-header">
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Button fx:id="backButton" text="Back" 
                        onAction="#handleBackButtonAction"
                        styleClass="secondary-button"/>
                <Label fx:id="workoutNameLabel" text="Workout Name" styleClass="title-label"/>
            </HBox>
            <Label fx:id="descriptionLabel" text="Workout description goes here..." wrapText="true"/>
            
            <HBox spacing="20.0">
                <Label fx:id="difficultyLabel" text="Difficulty: Intermediate"/>
                <Label fx:id="durationLabel" text="Duration: 45 minutes"/>
            </HBox>
            
            <Label fx:id="targetMusclesLabel" text="Target Muscles: Chest, Shoulders, Triceps"/>
            
            <HBox spacing="10.0">
                <Button fx:id="startWorkoutButton" text="Start Workout" 
                        onAction="#handleStartWorkoutButtonAction"
                        styleClass="primary-button"/>
                <Button fx:id="addToFavoritesButton" text="Add to Favorites" 
                        onAction="#handleAddToFavoritesButtonAction"
                        styleClass="secondary-button"/>
            </HBox>
            
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="10.0">
            <Label text="Exercises" styleClass="subtitle-label"/>
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button fx:id="addExerciseButton" text="Add Exercise" 
                        onAction="#handleAddExerciseButtonAction"
                        styleClass="action-button"/>
            </HBox>
            <ListView fx:id="exercisesListView" VBox.vgrow="ALWAYS"/>
            
            <padding>
                <Insets top="0.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
        </VBox>
    </center>
    <right>
        <VBox fx:id="exerciseDetailsContainer" spacing="10.0" prefWidth="250.0" styleClass="details-sidebar">
            <Label text="Exercise Details" styleClass="subtitle-label"/>
            <!-- Exercise details will be populated dynamically -->
            
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
        </VBox>
    </right>
    <bottom>
        <HBox alignment="CENTER" spacing="10.0" styleClass="footer">
            <padding>
                <Insets top="10.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
        </HBox>
    </bottom>
</BorderPane>
